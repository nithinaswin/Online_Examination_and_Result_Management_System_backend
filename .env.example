# Server Configuration
PORT=8080

# Database Configuration (MySQL / Aiven / Local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_system
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SSL_MODE=PREFERRED

# JWT Configuration
JWT_SECRET=superSecretJwtKeyMustBeAtLeast32BytesLongForHS256Algorithm
JWT_EXPIRATION_MS=86400000

# Bootstrap Initial Admin (Created once on startup if no admin exists)
ADMIN_EMAIL=admin@exam.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://exam-frontend.vercel.app

# Grace period in seconds for submission after exam window
EXAM_GRACE_PERIOD_SECONDS=15
